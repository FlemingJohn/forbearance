{
  "name": "forbearance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A public registry of proven inaction, built on the Attestcoin Protocol",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "chain:check": "tsx scripts/checkSupportedChains.ts",
    "chain:prove": "tsx scripts/proveTransaction.ts",
    "agent:run": "tsx scripts/runExaminer.ts",
    "contracts:build": "tsx scripts/compileContracts.ts",
    "contracts:deploy": "tsx scripts/deployRegistry.ts"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "^0.18.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "ethers": "^6.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "solc": "^0.8.36",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
